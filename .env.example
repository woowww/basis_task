API_KEY=change-me

# Для запуска вне docker-compose: postgres → localhost:5432, rabbitmq → localhost
DATABASE_URL=postgresql+asyncpg://payments:payments@postgres:5432/payments
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

RETRY_BASE_DELAY_SECONDS=1
MAX_ATTEMPTS=3
CONSUMER_PREFETCH=10

GATEWAY_SUCCESS_RATE=0.9
GATEWAY_MIN_DELAY_SECONDS=2
GATEWAY_MAX_DELAY_SECONDS=5

WEBHOOK_TIMEOUT_SECONDS=5

OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=100

LOG_LEVEL=INFO
